{
    "name": "libresign/wordpress-theme",
    "description": "WordPress theme for the LibreSign SaaS",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*"
            ]
        }
    ],
    "require": {
        "php": ">=8.3 <8.6"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "composer/installers": "^2.3",
        "roots/wordpress": "^7.0",
        "wp-phpunit/wp-phpunit": "^7.0",
        "wpackagist-plugin/woocommerce": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "LibreSign\\WordPressTheme\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        },
        "wordpress-install-dir": "vendor/wordpress",
        "installer-paths": {
            "vendor/test-plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude vendor-bin .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=2G",
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "ci": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
